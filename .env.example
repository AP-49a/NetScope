# NetScope — environment variable template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-me-before-production

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Scanner ──────────────────────────────────────────────────────────────────
# Leave blank to auto-detect the active interface.
PREFERRED_INTERFACE=

# ARP scan timeout in seconds (Phase 2)
SCAN_TIMEOUT=2

# ── Database ─────────────────────────────────────────────────────────────────
# Path is relative to the project root (Phase 2)
DATABASE_PATH=netscope.db
